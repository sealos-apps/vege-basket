DATABASE_URL=postgresql://user:password@host:5432/database
PORT=8787
APP_PUBLIC_URL=http://localhost:5173
APP_ENCRYPTION_ACTIVE_KEY_ID=v1
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEYS=v1:replace-with-32-byte-base64-key
# Comma-separated trusted usernames allowed to assign account roles. Empty disables role administration.
VEGES_ADMIN_USERNAMES=
# Fine-grained token scoped to sealos-apps/sealos-pro with Actions write permission.
GITHUB_ACTIONS_TOKEN=replace-with-github-actions-token
AI_RATE_LIMIT=5
AI_GLOBAL_RATE_LIMIT=30
AI_RATE_WINDOW_MS=60000
AI_MAX_MESSAGE_LENGTH=2000
AI_MAX_CONTEXT_CHARS=12000
AI_API_BASE=https://api.openai.com
AI_API_KEY=replace-with-ai-api-key
AI_MODEL=gpt-4.1-mini
FEISHU_WEBHOOK_USER_EMAIL=felix@vege.local
FEISHU_WEBHOOK_BASIC_USER=veges-feishu
FEISHU_WEBHOOK_BASIC_PASSWORD=replace-with-a-long-random-password
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=replace-with-feishu-app-secret
FEISHU_OAUTH_REDIRECT_URI=
FEISHU_OAUTH_STATE_SECRET=
# Required before enabling Feishu event or card-action callbacks.
FEISHU_VERIFICATION_TOKEN=replace-with-feishu-verification-token
FEISHU_ENCRYPT_KEY=
FEISHU_DELIVERY_ENABLED=true
# Enables private-chat AI replies, follow-up conversation, and todo proposal cards.
FEISHU_AI_CHAT_ENABLED=false
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=replace-with-oss-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-oss-access-key-secret
OSS_BUCKET=replace-with-oss-bucket
PACKAGE_MARKET_RULES_FILE=server/trial-combo-package-rules.yaml
# Compatibility fallback; preferred middleware discovery roots live in the YAML page_kinds section.
PACKAGE_MARKET_MIDDLEWARE_ROOT=cn-hangzhou/alphabiz
PACKAGE_MARKET_BASE_OBJECT_TEMPLATE=cn-hangzhou/applications/sealos-{deployType}.tar.gz
PACKAGE_MARKET_BASE_LIST_PREFIX_TEMPLATE=cn-hangzhou/applications/
PACKAGE_MARKET_DOWNLOAD_EXPIRE_SECONDS=600
